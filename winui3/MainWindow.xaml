<Window
    x:Class="SmartCr.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="smart-cr">
    <Grid Background="#F7F8FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#16222B" Padding="24,28">
            <Grid RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="smart-cr" Foreground="#F4C95D" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="课程表同步" Foreground="#AAB7BD" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="8">
                    <Button Content="总览" HorizontalContentAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="同步节点" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D7E0E4" />
                    <Button Content="应用设置" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#D7E0E4" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="安全连接 · 局域网发现" Foreground="#71818A" FontSize="11" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="42,34,42,42">
            <StackPanel MaxWidth="980" Spacing="26">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="同步总览" FontSize="32" FontWeight="SemiBold" Foreground="#16222B" />
                        <TextBlock Text="管理本机课程数据，并从局域网节点获取最新版本。" Margin="0,6,0,0" Foreground="#68767D" FontSize="14" />
                    </StackPanel>
                    <Button x:Name="RefreshButton" Click="RefreshButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Content="刷新" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" Padding="20" CornerRadius="8">
                        <StackPanel Spacing="8"><TextBlock Text="本地数据版本" Foreground="#68767D" /><TextBlock x:Name="VersionText" Text="检查中" FontSize="28" FontWeight="SemiBold" Foreground="#16222B" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" Padding="20" CornerRadius="8">
                        <StackPanel Spacing="8"><TextBlock Text="同步服务" Foreground="#68767D" /><TextBlock x:Name="ServiceText" Text="未启动" FontSize="28" FontWeight="SemiBold" Foreground="#2B7A68" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" Padding="20" CornerRadius="8">
                        <StackPanel Spacing="8"><TextBlock Text="可用节点" Foreground="#68767D" /><TextBlock x:Name="PeerText" Text="-" FontSize="28" FontWeight="SemiBold" Foreground="#16222B" /></StackPanel>
                    </Border>
                </Grid>

                <Border Background="#16222B" Padding="26" CornerRadius="8">
                    <Grid ColumnSpacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="后台同步" Foreground="#F4C95D" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="发现局域网中的 smart-cr 节点，自动检查并下载最新课程表。" Foreground="White" FontSize="18" />
                            <TextBlock x:Name="StatusText" Text="同步服务尚未启动" Foreground="#AAB7BD" />
                        </StackPanel>
                        <Button x:Name="SyncButton" Grid.Column="1" Click="SyncButton_Click" Content="启动同步" VerticalAlignment="Center" Padding="22,10" />
                    </Grid>
                </Border>

                <StackPanel Spacing="10">
                    <TextBlock Text="运行记录" FontSize="18" FontWeight="SemiBold" Foreground="#16222B" />
                    <Border Background="White" Padding="16" CornerRadius="8">
                        <TextBlock x:Name="LogText" Text="暂无记录" Foreground="#68767D" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>